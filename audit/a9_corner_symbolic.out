1. F_- == g' * D^3 sigma/(mu(1+e)): True
1. F_+ == g' * D^3 sigma/(mu(1+e)): True
1. F_- F_+ == mu^2 (PhiF - kappa^2 PsiF) with kappa = 1/mu: True
2. B(pi) == -2 p q (1-e): True
2. B'(pi) == 2p^2 - 2e + 2(e-1) q^2: True
2. D(pi) == 1-e: True
3. B at P_z=1,Q_z=0: 2*(e + cos(f))*sin(f) ; equals 2 sin f D ? False ; at e=1: True
3. PhiF - kappa^2 PsiF == 4 sin^2 f H1 H2 at P_z=1,Q_z=0: True
3. H2(f) == -H1(-f): True
3. P_f == (1-t)(PhiF - kappa^2 PsiF) when kappa^2 = t/(1-t): True
3. at e=1, mu=0, P_z=1: F_-F_+ == -4 sin^2 f D^4: True
4. min over |phi| of (2c^2 eps + 3c^2 phi^2 - 2k eps |phi|) = epsilon*(6*c2**2 - epsilon*k**2)/(3*c2) ; >= 0 iff eps <= 6 c^4/k^2 (=24 c^4 at k=1/2): 0
5. c_0 = e**4*(-b**2*q**2 - e**2 + p**2)/16 + i b*e**4*p*q/8
5. Re c_1 at q = 0, p = e: -e**5*(e - 1)*(e + 1)/4 ; Im c_1 there: 0
6. evolute cusp distance from centre (apse line) = a*e**2 ; focus distance a e; difference a e - a e^2 = -a*e*(e - 1)
