1. B1: Phi - Psi == e^3 G1: True ; Phi + Psi == e^2 G2: True
2. G1 mod b^2=1-e^2: b-linear part divisible by ph: True ; R0 at D1b point (e=0, ph=0, qh=1) == 0: True
2. G2 mod b^2=1-e^2: b-linear part divisible by ph: True ; R0 at D1b point (e=0, ph=0, qh=1) == 0: n/a
3. leading term F0 formula: True
